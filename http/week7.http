        client.assert(response.status === 401, "status: " + response.status);
        client.assert(response.body.code === "AUTH401_1", "code: " + response.body.code);
    });
%}

### 유저별 평점 조회 (공개, 토큰 없음) → 200
GET {{host}}/members/1/ratings


### ---------------------------------------------------------------------
### [선택 미션 1] 토큰 만료 직접 겪어보기
###   1) JWT_ACCESS_EXPIRATION=60 으로 바꾸고 서버 재시작
###   2) 위의 [미션 1] 로그인 A를 다시 실행 → 바로 아래 "만료 전" 실행 후 캡처
###   3) 약 2분 기다린 뒤 "만료 후" 실행 후 캡처
###      (JwtUtil이 시계 차이를 60초 허용하므로 만료 60초 + 여유 60초)
###   4) 끝나면 JWT_ACCESS_EXPIRATION=3600 으로 되돌리기
### ---------------------------------------------------------------------

### 📸 [선택] 만료 전 → 200
GET {{host}}/members/me
Authorization: Bearer {{tokenA}}

### 📸 [선택] 만료 후 (약 2분 뒤) → 401 AUTH401_4 (토큰 없음 AUTH401_2와 구분)
GET {{host}}/members/me
Authorization: Bearer {{tokenA}}

> {%
    client.test("[선택] 만료 토큰 401 AUTH401_4", function () {
        client.assert(response.status === 401, "status: " + response.status);
        client.assert(response.body.code === "AUTH401_4", "code: " + response.body.code);
    });
%}
